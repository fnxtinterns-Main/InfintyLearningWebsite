# ==============================================================================
# INFINITY LEARNING — EXAMPLE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file to .env and fill in your real credentials.

APP_NAME="Infinity Learning"
APP_TAGLINE="Learn. Grow. Achieve — Infinitely."
APP_URL="https://infintylearning.net"
APP_ENV="production"
APP_DEBUG=false
APP_KEY="your-32-character-secret-key-here"
APP_TIMEZONE="Asia/Kolkata"

DB_HOST="localhost"
DB_PORT=3306
DB_NAME="database_name"
DB_USER="database_user"
DB_PASS="database_password"
DB_CHARSET="utf8mb4"
DB_LOCK_TIMEOUT=5

REDIS_ENABLED=false
REDIS_SESSIONS=false
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_PREFIX="il:"
REDIS_TIMEOUT=1.5

CDN_ENABLED=true
CDN_URL=""

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="info@example.com"
SMTP_PASS="secret_password"
SMTP_FROM="info@example.com"
SMTP_FROM_NAME="Infinity Learning"

AI_AGENT_URL=""
AI_AGENT_KEY=""
