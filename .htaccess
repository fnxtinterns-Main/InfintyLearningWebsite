# ==============================================================================
# Infinity Learning — Root Deployment & Security Controller
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block all direct web access to sensitive directories and configs
    RewriteRule ^infinitylearning(/.*)?$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^\.git.*$ - [F,L]
    RewriteRule ^\.github.*$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # 2. Serve static assets directly from public_html if they exist
    RewriteCond %{REQUEST_URI} !^/public_html/
    RewriteCond %{DOCUMENT_ROOT}/public_html%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public_html/$1 [L]

    # 3. Route all application traffic to public_html/index.php
    RewriteCond %{REQUEST_URI} !^/public_html/
    RewriteRule ^(.*)$ public_html/index.php [QSA,L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Custom error pages
ErrorDocument 403 /public_html/maintenance.html
ErrorDocument 500 /public_html/maintenance.html
ErrorDocument 502 /public_html/maintenance.html
ErrorDocument 503 /public_html/maintenance.html
